{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "gen:api": "swagger-typescript-api generate -p http://localhost:4000/swagger.json --additional-properties kebab-file-name=true -r -o src/api --modular -d --extract-request-body --extract-response-body --extract-response-error --axios --use-type-imports --templates ./src/api/swagger-templates --single-http-client --extract-types",
    "gen:templates": "swagger-typescript-api generate-templates -p http://localhost:4000/swagger.json -r -o ./src/api/swagger-templates --modular -d --extract-request-body --extract-response-body --extract-response-error --axios --use-type-imports"
  },
  "dependencies": {
    "@appabbang/eslint": "workspace:*",
    "@appabbang/tailwind": "workspace:*",
    "@appabbang/typescript": "workspace:*",
    "@appabbang/ui": "workspace:*",
    "@faker-js/faker": "^9.6.0",
    "@ramonak/react-progress-bar": "^5.4.0",
    "@types/react-slick": "^0.23.13",
    "axios": "^1.9.0",
    "basic-loading": "^2.1.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.511.0",
    "react-daum-postcode": "^3.2.0",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.6",
    "styled-components": "^6.1.19",
    "zustand": "^5.0.5",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "swagger-typescript-api": "^13.2.7"
  }
}
