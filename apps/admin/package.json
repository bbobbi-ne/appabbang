{
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run gen:api && vite --port 3300",
    "start": "vite --port 3000",
    "build": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "gen:api": "swagger-typescript-api generate -p http://localhost:4000/swagger.json -r -o src/api --modular -d --extract-request-body --extract-response-body --extract-response-error --axios --use-type-imports --templates ./src/api/swagger-templates --single-http-client",
    "gen:templates": "swagger-typescript-api generate-templates -p http://localhost:4000/swagger.json -r -o ./src/api/swagger-templates --modular -d --extract-request-body --extract-response-body --extract-response-error --axios --use-type-imports"
  },
  "dependencies": {
    "@appabbang/eslint": "workspace:*",
    "@appabbang/tailwind": "workspace:*",
    "@appabbang/typescript": "workspace:*",
    "@appabbang/ui": "workspace:*",
    "@faker-js/faker": "^9.6.0",
    "axios": "^1.9.0",
    "lucide-react": "^0.511.0",
    "react-daum-postcode": "^3.2.0",
    "sonner": "^2.0.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "swagger-typescript-api": "^13.2.7"
  }
}
