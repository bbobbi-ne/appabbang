// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CommonCode {
  no                    Int               @id @default(autoincrement())
  groupName             String            @map("group_name") @db.VarChar(20)
  code                  String            @db.VarChar(5)
  name                  String            @db.VarChar(30)
  remarkTxt             String?           @map("remark_txt") @db.VarChar(500)

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@map("common_code")
}

model User {
  no                    Int               @id @default(autoincrement()) 
  id                    String            @unique                   
  pw                    String                                    
  name                  String                                     
  userRole              String            @db.VarChar(5) @map("user_role") 
  refreshToken          String?           @map("refresh_token") 

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt @map("updated_at")           

  @@map("users")
}

model Image {
  no                    Int               @id @default(autoincrement())     // Images.no
  url                   String                                              // 이미지 URL
  publicId              String            @map("public_id")                 // 퍼블릭 아이디 (Cloudinary 등)
  imageTargetType       String?           @map("image_target_type")         // 이미지 타입 (enum으로 관리 가능)
  imageTargetNo         Int?              @map("image_target_no")           // 참조 대상 No
  order                 Int?                                                // 이미지 정렬 순서
  name                  String?                                             // 원본 파일명

  createdAt             DateTime          @default(now()) @map("created_at") // 등록 시간
  updatedAt             DateTime          @updatedAt @map("updated_at")     // 수정 시간

  @@map("images")
}

model Bread {
  no                    Int               @id @default(autoincrement())
  name                  String
  description           String?
  unitPrice             Int
  breadStatus           String            @map("bread_status")
  countryOfOrigin       String            @map("country_of_origin") 
  allergyInfo           String           @map("allergy_info")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  orderItem             OrderItem[]
  orderRoundBreads      OrderRoundBread[]

  @@map("breads")
}

model Order {
  no                    Int               @id @default(autoincrement())
  orderNumber           String            @unique @map("orders_number")
  orderStatus           String            @map("order_status")
  totalPrice            Int               @map("total_price")
  discountAmount        Int               @map("discount_amount")
  orderPw               String?           @map("order_pw")      
  memo                  String?
  trackingNumber        String?           @map("tracking_number")
  canceledAt            DateTime?         @map("canceled_at")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  customerNo            Int               @map("customer_no")
  addressNo             Int?              @map("address_no")
  deliveryMethodNo      Int               @map("delivery_no")
  discountNo            Int?              @map("discount_no")
  customer              Customer          @relation(fields: [customerNo], references: [no])
  address               Address?          @relation(fields: [addressNo], references: [no])
  deliveryMethod        DeliveryMethod    @relation(fields: [deliveryMethodNo], references: [no])
  discount              Discount?         @relation(fields: [discountNo], references: [no])
  orderItem             OrderItem[]
  payment               Payment?

  @@map("orders")
}

model OrderItem {
  no                    Int               @id @default(autoincrement())
  quantity              Int     
  unitPrice             Int               @map("unit_price")
  totalPrice            Int               @map("total_price")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  orderNo               Int               @map("order_no")
  breadNo               Int               @map("bread_no")
  order                 Order             @relation(fields: [orderNo], references: [no], onDelete: Cascade)
  bread                 Bread             @relation(fields: [breadNo], references: [no])

  @@map("order_items")
}

model Customer {
  no                    Int               @id @default(autoincrement())
  id                    String?           @unique           
  pw                    String?           
  name                  String            
  mobileNumber          String            @map("mobile_number")               // 전화번호 (not null)
  defaultAddressNo      Int?              @map("default_address_no") 
  providerType          String?           @map("provider_type")               // 소셜 로그인 타입 코드 (nullable)
  socialId              String?           @map("social_id")                   // 소셜 로그인 식별자 (nullable)

  createdAt             DateTime          @default(now()) @map("created_at")  // 가입일 (not null)
  updatedAt             DateTime          @updatedAt @map("updated_at")

  order                 Order[]
  address               Address[]
  discountCustomer      DiscountCustomer[] 
  payment               Payment[]

  @@map("customers")
}

model Address {
  no                    Int               @id @default(autoincrement())
  address               String            
  addressDetail         String            @map("address_detail")
  zipcode               String
  message               String
  recipientName         String            @map("recipient_name")       // 수령인 이름
  recipientMobile       String            @map("recipient_mobile")     // 수령인 전화번호

  createdAt             DateTime          @default(now()) @map("created_at") 
  updatedAt             DateTime          @updatedAt @map("updated_at")

  customerNo            Int               @map("customer_no")
  customer              Customer          @relation(fields: [customerNo], references: [no], onDelete: Cascade)
  order                 Order[]

  @@map("addresses")
}

model DeliveryMethod {
  no                    Int               @id @default(autoincrement())
  name                  String
  memo                  String?
  fee                   Int
  isActive              Boolean           @map("is_active")
  deliveryType          String            @map("delivery_type")

  createdAt             DateTime          @default(now()) @map("created_at") 
  updatedAt             DateTime          @updatedAt @map("updated_at")

  order                 Order[]

  @@map("delivery_methods")
}

model Discount {
  no                    Int               @id @default(autoincrement()) // PK
  name                  String                                          // 할인정보명
  fromDt                DateTime                                        // 시작일
  toDt                  DateTime                                        // 종료일
  amount                Int?                                            // 할인금액 (정액 할인)
  percentage            Float?                                          // 할인률 (10%)
  discountType          String            @map("discount_type")
  memo                  String?                                         // 메모

  createdAt             DateTime @default(now())                        // 등록 시간
  updatedAt             DateTime @updatedAt                             // 수정 시간

  discountCustomer      DiscountCustomer[]
  order                 Order[]

  @@map("discounts")
}

model DiscountCustomer {
  customerNo            Int
  discountNo            Int
  isUsed                Boolean           @default(false)
  
  createdAt             DateTime          @default(now())               // 등록 시간
  updatedAt             DateTime          @updatedAt                    // 수정 시간 

  customer              Customer          @relation(fields: [customerNo], references: [no])
  discount              Discount          @relation(fields: [discountNo], references: [no])

  @@id([customerNo, discountNo])          // 복합 기본키
  @@map("discount_customer")
}

model Payment {
  no                  Int                 @id @default(autoincrement())
  isPaid              Boolean             @default(false) @map("is_paid")       // 입금확인여부
  orderedAt           DateTime            @map("ordered_at")                    // 주문일자
  paidConfirmedAt     DateTime?           @map("paid_confirmed_at")             // 입금확인일자
  isRefunded          Boolean             @default(false) @map("is_refunded")   // 환불여부
  refundRequestedAt   DateTime?           @map("refund_requested_at")           // 환불신청일자
  refundConfirmedAt   DateTime?           @map("refund_confirmed_at")            // 환불취소일자
  refundReason        String?             @map("refund_reason")                 // 환불사유
  bankCode            String              @map("bank_code")                     // 은행코드
  accountNumber       String              @map("account_number")                // 계좌번호
  accountHolderName   String              @map("account_holder_name")           // 예금주
  memo                String?             @map("memo")                          // 메모

  createdAt           DateTime            @default(now()) @map("created_at")    // 생성일자
  updatedAt           DateTime            @updatedAt @map("updated_at")         // 수정일자

  orderNo             Int                 @unique @map("order_no") 
  customerNo          Int                 @map("customer_no")
  order               Order               @relation(fields: [orderNo], references: [no])
  customer            Customer            @relation(fields: [customerNo], references: [no])

  @@map("payments")
}

/**
  주문차수
*/
model OrderRound {
  no                  Int                 @id @default(autoincrement())
  name                String
  startedAt           DateTime            @map("started_at")
  endedAt             DateTime            @map("ended_at")
  
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  breadNoList    OrderRoundBread[]   

  @@map("order_rounds")
}

model OrderRoundBread {
  no                  Int                 @id @default(autoincrement())
  seq                 Int                 @map("seq")
  breadNo             Int                 @map("bread_no")
  
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  orderRound          OrderRound          @relation(fields: [seq], references: [no])
  bread               Bread               @relation(fields: [breadNo], references: [no])

  @@unique([seq, breadNo])
  @@map("order_round_breads")
}